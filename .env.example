# AnswerBite Voice Agent - Environment Variables

# Supabase
SUPABASE_URL=https://hhigeeuddcgnrmgahfsy.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Groq - LLM + Whisper STT
GROQ_API_KEY=your_groq_api_key

# Default restaurant for testing
DEFAULT_RESTAURANT_ID=00000000-0000-0000-0000-000000000001

# Voice Pipeline - Kokoro TTS
# Mode: "api" = remote Kokoro-FastAPI server, "local" = kokoro-js running in Node
KOKORO_MODE=api
KOKORO_API_URL=http://localhost:8880/v1/audio/speech
KOKORO_API_KEY=not-needed
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.1

# Server
PORT=3001
